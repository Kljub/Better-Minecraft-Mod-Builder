# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnpm-*
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# synthetic fixtures are generated by tests/fixtures/generate-textures.mjs — keep the
# script committed, not its output, so texture-shape changes stay diffable in code.
/tests/fixtures/textures/

# real Minecraft/resource-pack-derived textures, produced locally by
# tests/scripts/extract-real-textures.mjs from a pack path in .env — never commit
# Mojang/Minecraft-derived assets.
/tests/fixtures/real-textures/

# next.js
/.next/
/out/
/tmp/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Codex Chat training data recorded without accounts (lib/server/chatDataset.ts)
/training-data/
